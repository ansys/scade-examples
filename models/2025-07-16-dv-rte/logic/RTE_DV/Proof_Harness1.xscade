					<pragmas>
						<ed:Variable oid="!ed/1ec/659B/B688/685ec0035e4d"/>
					</pragmas>
				</Variable>
			</locals>
			<data>
				<!-- _L1 = RTE_operator(_L2, _L3, _L4); -->
				<Equation>
					<lefts>
						<VariableRef name="_L1"/>
					</lefts>
					<right>
						<!-- RTE_operator(_L2, _L3, _L4) -->
						<CallExpression>
							<operator>
								<OpCall name="1">
									<operator>
										<OperatorRef name="RTE_operator"/>
									</operator>
								</OpCall>
							</operator>
							<callParameters>
								<IdExpression>
									<path>
										<ConstVarRef name="_L2"/>
									</path>
								</IdExpression>
								<IdExpression>
									<path>
										<ConstVarRef name="_L3"/>
									</path>
								</IdExpression>
								<IdExpression>
									<path>
										<ConstVarRef name="_L4"/>
									</path>
								</IdExpression>
							</callParameters>
							<pragmas>
								<ed:CallExpression xmlns="http://www.esterel-technologies.com/ns/scade/pragmas/editor/8">
									<references>
										<OperatorRef path="RTE_operator" refOid="!ed/a41a/513/130FC/685a425c3c5f">
											<InputRef refOid="!ed/a41c/513/130FC/685a426f803"/>
											<InputRef refOid="!ed/a42e/513/130FC/685a427bafd"/>
											<InputRef refOid="!ed/a44f/513/130FC/685a42aa36f1"/>
											<OutputRef refOid="!ed/a45e/513/130FC/685a42c238cb"/>
										</OperatorRef>
									</references>
								</ed:CallExpression>
							</pragmas>
						</CallExpression>
					</right>
					<pragmas>
						<ed:Equation oid="!ed/1e1/659B/B688/685ebffd75b7"/>
					</pragmas>
				</Equation>
				<!-- _L2 = a; -->
				<Equation>
					<lefts>
						<VariableRef name="_L2"/>
					</lefts>
					<right>
						<IdExpression>
							<path>
								<ConstVarRef name="a"/>
							</path>
						</IdExpression>
					</right>
					<pragmas>
						<ed:Equation oid="!ed/1e7/659B/B688/685ec003787f"/>
					</pragmas>
				</Equation>
