						<ed:Equation oid="!ed/1e9/659B/B688/685ec0038ca"/>
					</pragmas>
				</Equation>
				<!-- _L4 = c; -->
				<Equation>
					<lefts>
						<VariableRef name="_L4"/>
					</lefts>
					<right>
						<IdExpression>
							<path>
								<ConstVarRef name="c"/>
							</path>
						</IdExpression>
					</right>
					<pragmas>
						<ed:Equation oid="!ed/1eb/659B/B688/685ec0035134"/>
					</pragmas>
				</Equation>
				<!-- Output = _L1; -->
				<Equation>
					<lefts>
						<VariableRef name="Output"/>
					</lefts>
					<right>
						<IdExpression>
							<path>
								<ConstVarRef name="_L1"/>
							</path>
						</IdExpression>
					</right>
					<pragmas>
						<ed:Equation oid="!ed/1f1/659B/B688/685ec0132c52"/>
					</pragmas>
				</Equation>
				<Assertion kind="assume" name="A1">
					<definition>
						<!-- a > 0.0 and a <= 100.0 -->
						<NAryOp name="25" operator="and">
							<operands>
								<!-- a > 0.0 -->
								<BinaryOp name="18" operator="&gt;">
									<operands>
										<IdExpression>
											<path>
												<ConstVarRef name="a"/>
											</path>
										</IdExpression>
										<ConstValue value="0.0"/>
									</operands>
								</BinaryOp>
								<!-- a <= 100.0 -->
								<BinaryOp name="24" operator="&lt;=">
									<operands>
										<IdExpression>
											<path>
												<ConstVarRef name="a"/>
											</path>
										</IdExpression>
										<ConstValue value="100.0"/>
									</operands>
								</BinaryOp>
							</operands>
						</NAryOp>
					</definition>
					<pragmas>
						<ed:Assertion oid="!ed/1f6/659B/B688/685ec0396979"/>
					</pragmas>
				</Assertion>
				<Assertion kind="assume" name="A3">
					<definition>
						<!-- c > 10.0 and c <= 50.0 -->
						<NAryOp name="30" operator="and">
							<operands>
								<!-- c > 10.0 -->
								<BinaryOp name="24" operator="&gt;">
									<operands>
										<IdExpression>
											<path>
												<ConstVarRef name="c"/>
											</path>
										</IdExpression>
										<ConstValue value="10.0"/>
									</operands>
								</BinaryOp>
								<!-- c <= 50.0 -->
								<BinaryOp name="29" operator="&lt;=">
									<operands>
										<IdExpression>
											<path>
												<ConstVarRef name="c"/>
											</path>
										</IdExpression>
										<ConstValue value="50.0"/>
									</operands>
								</BinaryOp>
							</operands>
						</NAryOp>
					</definition>
					<pragmas>
						<ed:Assertion oid="!ed/386/659B/B688/685ec9cd7b0c"/>
					</pragmas>
				</Assertion>
				<Assertion kind="assume" name="A2">
					<definition>
						<!-- b > 0.0 and b <= 100.0 -->
						<NAryOp name="26" operator="and">
							<operands>
								<!-- b > 0.0 -->
								<BinaryOp name="19" operator="&gt;">
									<operands>
										<IdExpression>
											<path>
												<ConstVarRef name="b"/>
											</path>
										</IdExpression>
										<ConstValue value="0.0"/>
									</operands>
								</BinaryOp>
								<!-- b <= 100.0 -->
