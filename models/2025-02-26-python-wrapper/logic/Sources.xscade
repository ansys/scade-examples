						<Operator kind="function" visibility="private" name="DurationToCycles">
							<inputs>
								<Variable name="duration">
									<type>
										<NamedType>
											<type>
												<TypeRef name="'T"/>
											</type>
										</NamedType>
									</type>
									<pragmas>
										<ed:Variable oid="!ed/212/1A5D/22944/67bf294c34ff" xmlns="http://www.esterel-technologies.com/ns/scade/pragmas/editor/8">
											<comment>Value of the period</comment>
											<comment>Range: &gt;0</comment>
										</ed:Variable>
									</pragmas>
								</Variable>
								<Variable name="ts">
									<type>
										<NamedType>
											<type>
												<TypeRef name="'T"/>
											</type>
										</NamedType>
									</type>
									<pragmas>
										<ed:Variable oid="!ed/213/1A5D/22944/67bf294c41e9" xmlns="http://www.esterel-technologies.com/ns/scade/pragmas/editor/8">
											<comment>Time sample during the period</comment>
											<comment>Range: &gt;0</comment>
										</ed:Variable>
									</pragmas>
								</Variable>
							</inputs>
							<outputs>
								<Variable name="cycles">
									<type>
										<NamedType>
											<type>
												<TypeRef name="uint32"/>
											</type>
										</NamedType>
									</type>
									<pragmas>
										<ed:Variable oid="!ed/211/1A5D/22944/67bf294c50f8" xmlns="http://www.esterel-technologies.com/ns/scade/pragmas/editor/8">
											<comment>Number of samples for a period</comment>
										</ed:Variable>
									</pragmas>
								</Variable>
							</outputs>
							<numericTypes>
								<FloatType>
									<typeVar>
										<TypeRef name="'T"/>
									</typeVar>
								</FloatType>
							</numericTypes>
							<data>
								<IfBlock name="Robustness">
									<block>
										<IfNode>
											<if>
												<!-- duration < (0 : 'T) or ts <= (0 : 'T) -->
												<NAryOp name="1" operator="or">
													<operands>
														<!-- duration < (0 : 'T) -->
														<BinaryOp name="1" operator="&lt;">
															<operands>
																<IdExpression>
																	<path>
																		<ConstVarRef name="duration"/>
																	</path>
																</IdExpression>
																<!-- (0 : 'T) -->
																<NumericCastOp name="1">
																	<type>
																		<TypeRef name="'T"/>
																	</type>
																	<flow>
																		<ConstValue value="0"/>
																	</flow>
																</NumericCastOp>
															</operands>
														</BinaryOp>
														<!-- ts <= (0 : 'T) -->
														<BinaryOp name="1" operator="&lt;=">
															<operands>
																<IdExpression>
																	<path>
																		<ConstVarRef name="ts"/>
																	</path>
																</IdExpression>
																<!-- (0 : 'T) -->
																<NumericCastOp name="2">
																	<type>
																		<TypeRef name="'T"/>
																	</type>
																	<flow>
																		<ConstValue value="0"/>
																	</flow>
																</NumericCastOp>
															</operands>
														</BinaryOp>
													</operands>
												</NAryOp>
											</if>
											<then>
												<Action>
													<locals>
														<Variable name="_L1">
															<type>
																<NamedType>
																	<type>
																		<TypeRef name="uint32"/>
																	</type>
