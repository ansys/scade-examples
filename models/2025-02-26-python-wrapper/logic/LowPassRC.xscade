			<data>
				<!-- _L3 = _L2 * _L4; -->
				<Equation>
					<lefts>
						<VariableRef name="_L3"/>
					</lefts>
					<right>
						<!-- _L2 * _L4 -->
						<NAryOp name="1" operator="*">
