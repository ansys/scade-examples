						<NamedType>
							<type>
								<TypeRef name="float32"/>
							</type>
						</NamedType>
					</type>
					<pragmas>
						<ed:Variable oid="!ed/6a/6617/6AF4/673afa077ce6"/>
					</pragmas>
				</Variable>
			</locals>
			<data>
				<!-- _L1 = _L2 - _L3; -->
				<Equation>
					<lefts>
						<VariableRef name="_L1"/>
					</lefts>
					<right>
						<!-- _L2 - _L3 -->
						<BinaryOp name="1" operator="-">
							<operands>
								<IdExpression>
									<path>
										<ConstVarRef name="_L2"/>
									</path>
								</IdExpression>
								<IdExpression>
									<path>
										<ConstVarRef name="_L3"/>
									</path>
								</IdExpression>
							</operands>
						</BinaryOp>
					</right>
					<pragmas>
						<ed:Equation oid="!ed/4e/6617/6AF4/673af9d72e1a"/>
					</pragmas>
				</Equation>
				<!-- _L2 = C; -->
				<Equation>
					<lefts>
						<VariableRef name="_L2"/>
					</lefts>
					<right>
						<IdExpression>
							<path>
								<ConstVarRef name="C"/>
							</path>
						</IdExpression>
					</right>
					<pragmas>
						<ed:Equation oid="!ed/5b/6617/6AF4/673af9e64e28"/>
					</pragmas>
				</Equation>
				<!-- D = _L1; -->
				<Equation>
					<lefts>
						<VariableRef name="D"/>
					</lefts>
					<right>
						<IdExpression>
							<path>
								<ConstVarRef name="_L1"/>
							</path>
						</IdExpression>
					</right>
					<pragmas>
						<ed:Equation oid="!ed/64/6617/6AF4/673af9eb3a08"/>
					</pragmas>
				</Equation>
				<!-- _L3 = 10.0_f32; -->
				<Equation>
					<lefts>
						<VariableRef name="_L3"/>
					</lefts>
					<right>
						<ConstValue value="10.0_f32"/>
					</right>
					<pragmas>
						<ed:Equation oid="!ed/69/6617/6AF4/673afa075093"/>
					</pragmas>
				</Equation>
			</data>
