	<declarations>
		<Operator kind="function" name="MyOp2">
			<inputs>
				<Variable name="C">
					<type>
						<NamedType>
							<type>
								<TypeRef name="float32"/>
							</type>
						</NamedType>
					</type>
					<pragmas>
						<ed:Variable oid="!ed/2a/6617/6AF4/673af9b440a1"/>
						<cnxwrp:Pragma>
							{&quot;is_topic&quot;: true}
